{
  "name": "projeto2-ecommerce-solid",
  "version": "2.0.0",
  "description": "Refatoração do projeto de comércio eletrônico aplicando princípios SOLID",
  "main": "dist/src/server.js",
  "scripts": {
    "desenvolver": "tsx watch src/server.ts",
    "verificar": "tsc --noEmit",
    "prisma:gerar": "prisma generate",
    "prisma:migrar": "node --import tsx prisma/prepararBanco.ts && prisma migrate deploy",
    "prisma:popular": "node --import tsx prisma/popular.ts",
    "testar": "node --import tsx verificacoes/pedidos.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "node --import tsx verificacoes/pedidos.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --import tsx prisma/prepararBanco.ts && prisma migrate deploy",
    "prisma:seed": "node --import tsx prisma/popular.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^4.21.0",
    "inversify": "^7.11.0",
    "nodemailer": "^7.0.11",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.27",
    "@types/nodemailer": "^7.0.4",
    "prisma": "^6.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
